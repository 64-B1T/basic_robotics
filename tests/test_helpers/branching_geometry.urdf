<?xml version="1.0" ?>
<robot name="branching_geometry">

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  <joint name="stub_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stub_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.1 0.0 0.0"/>
  </joint>
  <joint name="joint1" type="continuous">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="joint2" type="continuous">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="leafA_joint" type="fixed">
    <parent link="link2"/>
    <child link="leafA_link"/>
    <origin rpy="0 0 0" xyz="0.05 0 0"/>
  </joint>
  <joint name="leafB_joint" type="fixed">
    <parent link="link2"/>
    <child link="leafB_link"/>
    <origin rpy="0 0 0" xyz="-0.05 0 0"/>
  </joint>

  <link name="world"/>
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <link name="stub_link"/>
  <link name="link1">
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.2"/>
      </geometry>
    </visual>
  </link>
  <link name="link2">
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>
  </link>
  <link name="leafA_link"/>
  <link name="leafB_link"/>
</robot>
